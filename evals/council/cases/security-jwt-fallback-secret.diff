+authRouter.post("/refresh", async (req, res) => {
+  const { userId, refreshToken } = req.body ?? {};
+  if (!userId || !refreshToken) return res.status(400).json({ error: "missing fields" });
+  const next = await rotateRefreshToken(userId, refreshToken);
