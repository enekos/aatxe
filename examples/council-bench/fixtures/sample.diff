+pub async fn fetch(url: &str) -> reqwest::Result<String> {
+    let client = Client::new();
+    let mut bodies = Vec::new();
+    for _ in 0..10 {
+        let body = client.get(url).send().await?.text().await?;
+        bodies.push(body);
+    }
+    Ok(bodies.into_iter().collect())
