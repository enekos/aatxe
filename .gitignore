/target
**/*.rs.bk
Cargo.lock.bak

# Per-language SDK artifacts
sdk/ts/node_modules
sdk/ts/dist
sdk/ts/*.tsbuildinfo
sdk/go/.aatxe-cache

# Svelte dashboard frontend — node_modules only; the built bundle in
# crates/aatxe-ui/assets is committed (the Rust crate embeds it).
crates/aatxe-ui/ui/node_modules
crates/aatxe-ui/ui/.vite

# Example artifacts
examples/**/node_modules
examples/**/target
examples/**/dist
examples/**/*.tsbuildinfo

# Editor + OS
.DS_Store
.idea
.vscode
*.swp

# Aatxe output
**/aatxe.json
**/aatxe-report.json
**/aatxe-report.md

# Local dev artefacts (calibration sweeps, smoke runs, logs)
tmp/calibrate/
tmp/smoke/
tmp/*.log
tmp/aatxe-go-runner

# Secrets
.env
.env.local
.secrets
